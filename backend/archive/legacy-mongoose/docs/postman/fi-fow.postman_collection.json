{
  "info": { "name": "Fi Fow API - Sprints 0 à 22", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:5000/api" }, { "key": "token", "value": "" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Send OTP", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"phone\": \"+224620000000\"\n}"}, "url": "{{baseUrl}}/auth/send-otp" } },
    { "name": "Verify OTP", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"phone\": \"+224620000000\",\n  \"otp\": \"123456\"\n}"}, "url": "{{baseUrl}}/auth/verify-otp" } },
    { "name": "Admin Dashboard", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/admin/dashboard" } },
    { "name": "Settings", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/admin/settings" } }
  ]
}
