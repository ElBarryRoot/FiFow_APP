NODE_ENV=development
PORT=5000
API_PUBLIC_URL=http://localhost:5000
WEB_APP_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5173
DATABASE_URL=postgresql://fifow:fifow_local_password@localhost:5432/fifow?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=CHANGE_ME_access_secret_minimum_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_minimum_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=fifow_refresh
BCRYPT_SALT_ROUNDS=12

EMAIL_AUTH_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_DRIVER=console
EMAIL_FROM=no-reply@fifow.local
EMAIL_TOKEN_EXPIRES_MINUTES=30
PASSWORD_RESET_EXPIRES_MINUTES=20
SMS_AUTH_ENABLED=false

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=20
CORS_ORIGINS=http://localhost:5173,http://localhost:19006,http://localhost:8081
SWAGGER_ENABLED=true

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_PUBLIC_PATH=/uploads
MAX_IMAGE_BYTES=5242880
MAX_PRODUCT_IMAGES=6

PAYMENT_ENABLED=false
PAYMENT_SANDBOX_ENABLED=false
PAYMENT_PROVIDER=MOCK
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_payment_webhook_secret_minimum_64_chars

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
