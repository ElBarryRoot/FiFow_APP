generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  ARCHIVED
}

enum SellerVerificationStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  AVAILABLE
  RESERVED
  SOLD
  REJECTED
  HIDDEN
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  HIDDEN
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  TO_REPAIR
}

enum ListingMode {
  SINGLE
  STOCK
  LOT
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum HandoverMode {
  HAND_TO_HAND
  HOME_DELIVERY
  PICKUP_POINT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
  DISPUTED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
  EXPIRED
}

enum OrderStatus {
  AWAITING_SELLER_CONFIRMATION
  AWAITING_PAYMENT
  PAID
  RESERVED
  PREPARING
  READY_FOR_HANDOVER
  IN_DELIVERY
  RECEIVED
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum OrderActor {
  SYSTEM
  BUYER
  SELLER
  ADMIN
  PAYMENT_PROVIDER
}

enum Currency {
  GNF
}

enum PaymentProvider {
  MOCK
  ORANGE_MONEY
  MTN_MOMO
  OTHER
}

enum PaymentType {
  ORDER
  DELIVERY
  BOOST
  SUBSCRIPTION
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  BLOCKED
  SCHEDULED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerEntryType {
  PAYMENT
  BUYER_PROTECTION
  DELIVERY_FEE
  SELLER_PAYABLE
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum DeliveryStatus {
  NOT_REQUIRED
  PENDING
  PICKUP_READY
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  PENDING_MODERATION
  HIDDEN
  ARCHIVED
}

enum ReportTargetType {
  PRODUCT
  USER
  MESSAGE
  REVIEW
  PAYMENT
  CONVERSATION
  ORDER
}

enum ReportReason {
  SCAM
  FAKE_PRODUCT
  FORBIDDEN_PRODUCT
  BAD_BEHAVIOR
  OFFENSIVE_CONTENT
  MISLEADING_PRICE
  STOLEN_IMAGE
  UNREACHABLE_SELLER
  PAYMENT_ISSUE
  DELIVERY_ISSUE
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModerationActionType {
  WARNING
  HIDE_PRODUCT
  ARCHIVE_PRODUCT
  RESTORE_PRODUCT
  SUSPEND_USER
  BAN_USER
  RESTORE_USER
  REMOVE_VERIFIED_BADGE
  HIDE_REVIEW
  RESTORE_REVIEW
  REJECT_REPORT
  BLOCK_CONVERSATION
  UNBLOCK_CONVERSATION
  REFUND_PAYMENT
}

enum NotificationType {
  NEW_MESSAGE
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUND_UPDATED
  PRODUCT_LIKED
  PRODUCT_FAVORITED
  PRODUCT_MODERATED
  REVIEW_RECEIVED
  BOOST_ACTIVATED
  BOOST_EXPIRED
  SECURITY_ALERT
  SYSTEM
}

enum BoostStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

enum BoostPlacement {
  HOME_FEED
  SEARCH_RESULTS
  CATEGORY_PAGE
  SIMILAR_PRODUCTS
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                       String                   @id @default(uuid()) @db.Uuid
  email                    String                   @unique @db.VarChar(254)
  passwordHash             String?                  @map("password_hash") @db.VarChar(255)
  fullName                 String                   @map("full_name") @db.VarChar(80)
  phone                    String?                  @unique @db.VarChar(30)
  emailVerifiedAt          DateTime?                @map("email_verified_at")
  phoneVerifiedAt          DateTime?                @map("phone_verified_at")
  commune                  String?                  @db.VarChar(80)
  quartier                 String?                  @db.VarChar(80)
  avatarKey                String?                  @map("avatar_key") @db.VarChar(500)
  role                     UserRole                 @default(USER)
  status                   UserStatus               @default(ACTIVE)
  sellerVerificationStatus SellerVerificationStatus @default(NOT_REQUESTED) @map("seller_verification_status")
  canManageStock           Boolean                  @default(false) @map("can_manage_stock")
  averageRating            Decimal                  @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalReviews             Int                      @default(0) @map("total_reviews")
  trustScore               Int                      @default(0) @map("trust_score")
  failedLoginAttempts      Int                      @default(0) @map("failed_login_attempts")
  lockedUntil              DateTime?                @map("locked_until")
  passwordChangedAt        DateTime?                @map("password_changed_at")
  termsAcceptedAt          DateTime?                @map("terms_accepted_at")
  termsVersion             String?                  @map("terms_version") @db.VarChar(40)
  lastLoginAt              DateTime?                @map("last_login_at")
  lastActiveAt             DateTime?                @map("last_active_at")
  archivedAt               DateTime?                @map("archived_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  sessions                 Session[]
  usersBlocked             UserBlock[]              @relation("Blocker")
  blockedBy                UserBlock[]              @relation("Blocked")
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  products                 Product[]                @relation("ProductSeller")
  productImages            ProductImage[]           @relation("ProductImageSeller")
  favorites                Favorite[]
  productLikes             ProductLike[]
  productViews             ProductView[]
  buyerConversations       Conversation[]           @relation("ConversationBuyer")
  sellerConversations      Conversation[]           @relation("ConversationSeller")
  messages                 Message[]
  offersCreated            Offer[]                  @relation("OfferCreator")
  offersReceived           Offer[]                  @relation("OfferRecipient")
  ordersBought             Order[]                  @relation("OrderBuyer")
  ordersSold               Order[]                  @relation("OrderSeller")
  orderStatusChanges       OrderStatusHistory[]     @relation("OrderStatusActor")
  checkoutQuotes           CheckoutQuote[]
  cart                     Cart?
  payments                 Payment[]
  refundRequests           Refund[]                 @relation("RefundRequester")
  payouts                  Payout[]                 @relation("PayoutSeller")
  reviewsWritten           Review[]                 @relation("ReviewAuthor")
  reviewsReceived          Review[]                 @relation("ReviewSubject")
  reportsFiled             Report[]                 @relation("ReportReporter")
  reportsAssigned          Report[]                 @relation("ReportAssignee")
  moderationActions        ModerationAction[]       @relation("ModerationActor")
  notifications            Notification[]
  boosts                   Boost[]                  @relation("BoostSeller")
  adminLogs                AdminLog[]               @relation("AdminLogActor")
  settingsUpdated          AppSetting[]             @relation("SettingUpdater")
  sellerVerification       SellerVerification?      @relation("SellerVerificationUser")
  verificationsReviewed    SellerVerification[]     @relation("SellerVerificationReviewer")
  supportTicketsRequested  SupportTicket[]          @relation("SupportTicketRequester")
  supportTicketsAssigned   SupportTicket[]          @relation("SupportTicketAssignee")
  supportMessages          SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([role, status])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  tokenFamily      String    @map("token_family") @db.Uuid
  deviceName       String?   @map("device_name") @db.VarChar(120)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.Text
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamily])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
  @@map("user_blocks")
}

model Category {
  id                      String     @id @default(uuid()) @db.Uuid
  parentId                String?    @map("parent_id") @db.Uuid
  name                    String     @db.VarChar(80)
  slug                    String     @unique @db.VarChar(100)
  description             String?    @db.VarChar(500)
  iconKey                 String?    @map("icon_key") @db.VarChar(500)
  imageKey                String?    @map("image_key") @db.VarChar(500)
  isActive                Boolean    @default(true) @map("is_active")
  isSensitive             Boolean    @default(false) @map("is_sensitive")
  requiresAdminValidation Boolean    @default(false) @map("requires_admin_validation")
  sortOrder               Int        @default(0) @map("sort_order")
  archivedAt              DateTime?  @map("archived_at")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")
  parent                  Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                Category[] @relation("CategoryHierarchy")
  products                Product[]  @relation("ProductCategory")
  subcategoryItems        Product[]  @relation("ProductSubcategory")

  @@unique([parentId, name])
  @@index([parentId, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                    String                 @id @default(uuid()) @db.Uuid
  sellerId              String                 @map("seller_id") @db.Uuid
  categoryId            String                 @map("category_id") @db.Uuid
  subcategoryId         String                 @map("subcategory_id") @db.Uuid
  title                 String                 @db.VarChar(120)
  slug                  String                 @unique @db.VarChar(160)
  description           String                 @db.Text
  price                 BigInt
  currency              Currency               @default(GNF)
  condition             ProductCondition
  listingMode           ListingMode            @default(SINGLE) @map("listing_mode")
  stockQuantity         Int                    @default(1) @map("stock_quantity")
  reservedQuantity      Int                    @default(0) @map("reserved_quantity")
  isNegotiable          Boolean                @map("is_negotiable")
  commune               String                 @db.VarChar(80)
  quartier              String                 @db.VarChar(80)
  handoverModes         HandoverMode[]         @map("handover_modes")
  status                ProductStatus          @default(DRAFT)
  moderationStatus      ModerationStatus       @default(PENDING) @map("moderation_status")
  moderationReason      String?                @map("moderation_reason") @db.VarChar(1000)
  viewsCount            Int                    @default(0) @map("views_count")
  likesCount            Int                    @default(0) @map("likes_count")
  favoritesCount        Int                    @default(0) @map("favorites_count")
  conversationsCount    Int                    @default(0) @map("conversations_count")
  reportsCount          Int                    @default(0) @map("reports_count")
  publishedAt           DateTime?              @map("published_at")
  reservedAt            DateTime?              @map("reserved_at")
  soldAt                DateTime?              @map("sold_at")
  archivedAt            DateTime?              @map("archived_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  seller                User                   @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  category              Category               @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory           Category               @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  images                ProductImage[]
  favorites             Favorite[]
  likes                 ProductLike[]
  views                 ProductView[]
  conversations         Conversation[]
  offers                Offer[]
  quotes                CheckoutQuote[]
  quoteItems            CheckoutQuoteItem[]
  orders                Order[]
  orderItems            OrderItem[]
  cartItems             CartItem[]
  inventoryReservations InventoryReservation[]
  reviews               Review[]
  boosts                Boost[]

  @@index([status, moderationStatus, publishedAt(sort: Desc)])
  @@index([categoryId, subcategoryId, status])
  @@index([commune, quartier, status])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([price, status])
  @@map("products")
}

model ProductImage {
  id               String           @id @default(uuid()) @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  sellerId         String           @map("seller_id") @db.Uuid
  storageKey       String           @unique @map("storage_key") @db.VarChar(500)
  mimeType         String           @map("mime_type") @db.VarChar(80)
  width            Int
  height           Int
  sizeBytes        Int              @map("size_bytes")
  isMain           Boolean          @default(false) @map("is_main")
  sortOrder        Int              @default(0) @map("sort_order")
  moderationStatus ModerationStatus @default(PENDING) @map("moderation_status")
  archivedAt       DateTime?        @map("archived_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller           User             @relation("ProductImageSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([productId, sortOrder])
  @@index([productId, isMain, archivedAt])
  @@map("product_images")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorites")
}

model ProductLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_likes")
}

model ProductView {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  visitorKey String   @map("visitor_key") @db.VarChar(128)
  ipHash     String?  @map("ip_hash") @db.VarChar(128)
  userAgent  String?  @map("user_agent") @db.Text
  viewedAt   DateTime @default(now()) @map("viewed_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, viewedAt])
  @@index([visitorKey, productId, viewedAt])
  @@map("product_views")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  buyerId   String     @unique @map("buyer_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  buyer     User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id                  String   @id @default(uuid()) @db.Uuid
  cartId              String   @map("cart_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  quantity            Int      @default(1)
  unitPriceAtAddition BigInt   @map("unit_price_at_addition")
  currency            Currency @default(GNF)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([cartId, createdAt])
  @@index([productId])
  @@map("cart_items")
}

model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  buyerId           String             @map("buyer_id") @db.Uuid
  sellerId          String             @map("seller_id") @db.Uuid
  status            ConversationStatus @default(ACTIVE)
  lastMessageText   String?            @map("last_message_text") @db.VarChar(220)
  lastMessageAt     DateTime?          @map("last_message_at")
  unreadCountBuyer  Int                @default(0) @map("unread_count_buyer")
  unreadCountSeller Int                @default(0) @map("unread_count_seller")
  buyerArchivedAt   DateTime?          @map("buyer_archived_at")
  sellerArchivedAt  DateTime?          @map("seller_archived_at")
  isReported        Boolean            @default(false) @map("is_reported")
  reportCount       Int                @default(0) @map("report_count")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer             User               @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller            User               @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  messages          Message[]
  offers            Offer[]
  orders            Order[]

  @@unique([productId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@index([isReported, status, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  clientId       String?      @map("client_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  type           MessageType  @default(TEXT)
  text           String?      @db.Text
  mediaKey       String?      @map("media_key") @db.VarChar(500)
  readAt         DateTime?    @map("read_at")
  editedAt       DateTime?    @map("edited_at")
  archivedAt     DateTime?    @map("archived_at")
  isReported     Boolean      @default(false) @map("is_reported")
  reportCount    Int          @default(0) @map("report_count")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@map("messages")
}

model Offer {
  id             String              @id @default(uuid()) @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  creatorId      String              @map("creator_id") @db.Uuid
  recipientId    String              @map("recipient_id") @db.Uuid
  parentOfferId  String?             @map("parent_offer_id") @db.Uuid
  amount         BigInt
  currency       Currency            @default(GNF)
  handoverMode   HandoverMode        @map("handover_mode")
  status         OfferStatus         @default(PENDING)
  message        String?             @db.VarChar(500)
  expiresAt      DateTime            @map("expires_at")
  respondedAt    DateTime?           @map("responded_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  creator        User                @relation("OfferCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  recipient      User                @relation("OfferRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  parentOffer    Offer?              @relation("OfferCounterChain", fields: [parentOfferId], references: [id], onDelete: Restrict)
  counterOffers  Offer[]             @relation("OfferCounterChain")
  acceptedOrder  Order?              @relation("AcceptedOffer")
  quotes         CheckoutQuote[]
  quoteItems     CheckoutQuoteItem[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([recipientId, status, expiresAt])
  @@index([productId, status])
  // Migration 20260805_000003 enforces one PENDING offer per conversation
  // with a PostgreSQL partial unique index that Prisma cannot express here.
  @@map("offers")
}

model CheckoutQuote {
  id                 String              @id @default(uuid()) @db.Uuid
  buyerId            String              @map("buyer_id") @db.Uuid
  productId          String              @map("product_id") @db.Uuid
  offerId            String?             @map("offer_id") @db.Uuid
  itemAmount         BigInt              @map("item_amount")
  buyerProtectionFee BigInt              @map("buyer_protection_fee")
  deliveryFee        BigInt              @map("delivery_fee")
  discountAmount     BigInt              @default(0) @map("discount_amount")
  totalAmount        BigInt              @map("total_amount")
  sellerNetAmount    BigInt              @map("seller_net_amount")
  currency           Currency            @default(GNF)
  handoverMode       HandoverMode        @map("handover_mode")
