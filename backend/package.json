{
  "name": "fi-fow-backend",
  "version": "1.0.0",
  "description": "API transactionnelle Fi Fow - PostgreSQL, Prisma et Express",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "start": "node dist/src/server.js",
    "lint": "node node_modules/eslint/bin/eslint.js \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "seed": "node --import tsx prisma/seed.ts",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:validate": "node node_modules/prisma/build/index.js validate",
    "prisma:migrate:dev": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "prisma:studio": "node node_modules/prisma/build/index.js studio",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "build": "npm run prisma:generate && npm run typecheck && node node_modules/typescript/bin/tsc"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.1",
    "supertest": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
